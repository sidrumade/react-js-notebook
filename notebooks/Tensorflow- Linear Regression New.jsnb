      "html_element": "\n  <div id=\"final_plot_7247\" style=\"min-height: 250px;min-width: 500px\"><b>Rendering Final Predictive Layer...</b></div>\n  <script>\n    const renderPredictions = () => {\n      tfvis.render.scatterplot(\n        document.getElementById('final_plot_7247'), \n        {\n          values: [[{\"x\":150,\"y\":17},{\"x\":140,\"y\":17},{\"x\":105,\"y\":16},{\"x\":70,\"y\":29},{\"x\":75,\"y\":28},{\"x\":70,\"y\":34.5},{\"x\":100,\"y\":19},{\"x\":115,\"y\":21.6},{\"x\":74,\"y\":36},{\"x\":130,\"y\":13},{\"x\":175,\"y\":13},{\"x\":74,\"y\":31.6},{\"x\":93,\"y\":26},{\"x\":83,\"y\":33.5},{\"x\":225,\"y\":14},{\"x\":190,\"y\":13},{\"x\":175,\"y\":13},{\"x\":148,\"y\":14},{\"x\":75,\"y\":30.9},{\"x\":64,\"y\":39},{\"x\":63,\"y\":34.7},{\"x\":98,\"y\":18.5},{\"x\":150,\"y\":13},{\"x\":190,\"y\":15},{\"x\":97,\"y\":18},{\"x\":80,\"y\":26},{\"x\":100,\"y\":22},{\"x\":85,\"y\":17.6},{\"x\":90,\"y\":22.5},{\"x\":90,\"y\":28.4},{\"x\":105,\"y\":22},{\"x\":150,\"y\":13},{\"x\":94,\"y\":22},{\"x\":77,\"y\":25.4},{\"x\":68,\"y\":34.1},{\"x\":110,\"y\":18},{\"x\":170,\"y\":15.5},{\"x\":165,\"y\":13},{\"x\":75,\"y\":29},{\"x\":145,\"y\":13},{\"x\":61,\"y\":32},{\"x\":70,\"y\":39.4},{\"x\":120,\"y\":18.1},{\"x\":95,\"y\":25},{\"x\":150,\"y\":15},{\"x\":79,\"y\":26},{\"x\":150,\"y\":14},{\"x\":78,\"y\":34.3},{\"x\":90,\"y\":24},{\"x\":145,\"y\":15},{\"x\":100,\"y\":18},{\"x\":75,\"y\":24},{\"x\":95,\"y\":24},{\"x\":110,\"y\":22.4},{\"x\":84,\"y\":32},{\"x\":92,\"y\":25},{\"x\":65,\"y\":40.8},{\"x\":88,\"y\":36},{\"x\":78,\"y\":29},{\"x\":102,\"y\":20},{\"x\":70,\"y\":32.1},{\"x\":155,\"y\":13},{\"x\":85,\"y\":20.2},{\"x\":95,\"y\":25},{\"x\":158,\"y\":13},{\"x\":66,\"y\":36.1},{\"x\":72,\"y\":15},{\"x\":75,\"y\":36},{\"x\":110,\"y\":24},{\"x\":85,\"y\":31},{\"x\":105,\"y\":16},{\"x\":139,\"y\":20.2},{\"x\":112,\"y\":19},{\"x\":95,\"y\":20.5},{\"x\":110,\"y\":20},{\"x\":72,\"y\":32.4},{\"x\":90,\"y\":19.1},{\"x\":129,\"y\":13},{\"x\":115,\"y\":25},{\"x\":72,\"y\"