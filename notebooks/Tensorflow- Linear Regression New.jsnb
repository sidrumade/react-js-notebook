    {
      "id": "ea3a44edb1604f6aa208d19bbc9681ce",
      "cell_type": "code",
      "execution_count": 3,
      "is_executing": false,
      "cellindex_value": 2,
      "output": [
        "Model mathematical node tree initialized! Commencing training...",
        "Epoch 0 | Training Loss (MSE): 0.0829",
        "Epoch 10 | Training Loss (MSE): 0.0174",
        "Epoch 20 | Training Loss (MSE): 0.0215",
        "Epoch 30 | Training Loss (MSE): 0.0198",
        "Epoch 40 | Training Loss (MSE): 0.0188",
        "Final Neural Network Matrix mathematically trained completely!"
      ],
      "editorsValue": "(async () => {\n    // Package raw mathematical arrays securely into Tensors & Normalize\n    function convertToTensor(data) {\n      return tf.tidy(() => {\n        tf.util.shuffle(data);\n        const inputs = data.map(d => d.horsepower)\n        const labels = data.map(d => d.mpg);\n        const inputTensor = tf.tensor2d(inputs, [inputs.length, 1]);\n        const labelTensor = tf.tensor2d(labels, [labels.length, 1]);\n\n        const inputMax = inputTensor.max(), inputMin = inputTensor.min();  \n        const labelMax = labelTensor.max(), labelMin = labelTensor.min();\n        \n        // Normalize Data \n        const normalizedInputs = inputTensor.sub(inputMin).div(inputMax.sub(inputMin));\n        const normalizedLabels = labelTensor.sub(labelMin).div(labelMax.sub(labelMin));\n\n        return { inputs: normalizedInputs, labels: normalizedLabels, inputMax, inputMin, labelMax, labelMin };\n      });\n    }\n\n    // Convert using our globally stored dataset\n    global.tensorData = convertToTensor(global.cleaned);\n    const {inputs, labels} = global.tensorData;\n\n    // Build Layered Network Matrix\n    global.model = tf.sequential();\n    global.model.add(tf.layers.dense({inputShape: [1], units: 1, useBias: true}));\n    global.model.add(tf.layers.dense({units: 1, useBias: true}));\n    global.model.compile({ optimizer: tf.train.adam(0.1), loss: tf.losses.meanSquaredError, metrics: ['mse'] });\n\n    console.log(\"Model mathematical node tree initialized! Commencing training...\");\n\n    // Initiate Training Loop Background Thread\n    await global.model.fit(inputs, labels, {\n      batchSize: 32,\n      epochs: 50,\n      callbacks: {\n        onEpochEnd: (epoch, logs) => {\n            // Output smoothly to our JS cell output directly\n            if (epoch % 10 === 0) console.log(`Epoch ${epoch} | Training Loss (MSE): ${logs.loss.toFixed(4)}`);\n        }\n      }\n    });\n\n    console.log(\"Final Neural Network Matrix mathematically trained completely!\");\n})();\n",
      "rows": 48,
      "plotly_input": {},
      "html_element": "",
      "error": "",
      "executionTime": "4.75"
    },
    {
      "id": "43275e73406748b790ee8d7e1d75b282",
      "cell_type": "code",
      "execution_count": 4,
      "is_executing": false,
      "cellindex_value": 3,
      "output": [
        "Plotted Result Graphs directly inline!"
      ],
      "editorsValue": "// Synchronously Predict linearly evaluated bounds\nconst {inputMax, inputMin, labelMin, labelMax} = global.tensorData;\n\nconst [unNormXs, unNormPreds] = tf.tidy(() => {\n   const xs = tf.linspace(0, 1, 100);\n   const preds = global.model.predict(xs.reshape([100, 1]));\n   const unNormXs = xs.mul(inputMax.sub(inputMin)).add(inputMin);\n   const unNormPreds = preds.mul(labelMax.sub(labelMin)).add(labelMin);\n   return [unNormXs.dataSync(), unNormPreds.dataSync()];\n});\n\n// Package up raw datasets\nconst originalPoints = global.cleaned.map(d => ({x: d.horsepower, y: d.mpg}));\nconst predictedPoints = Array.from(unNormXs).map((val, i) => {\n  return {x: val, y: unNormPreds[i]}\n});\n\nconst finalPlotId = \"final_plot_\" + Math.floor(Math.random()*10000);\n\n// Ship the mathematical results straight up to the frontend UI!\ninsertHTML(`\n  <div id=\"${finalPlotId}\" style=\"min-height: 250px;min-width: 500px\"><b>Rendering Final Predictive Layer...</b></div>\n  <script>\n    const renderPredictions = () => {\n      tfvis.render.scatterplot(\n        document.getElementById('${finalPlotId}'), \n        {\n          values: [${JSON.stringify(originalPoints)}, ${JSON.stringify(predictedPoints)}], \n          series: ['Original Reality', 'Model Linear Inferences']\n        }, \n        { xLabel: 'Horsepower', yLabel: 'MPG', height: 350 }\n      );\n    };\n\n    if (!window.tfvis) {\n       let s = document.createElement('script');\n       s.src = \"https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-vis\";\n       s.onload = renderPredictions;\n       document.head.appendChild(s);\n    } else {\n       renderPredictions();\n    }\n  </script>\n`);\n\nconsole.log(\"Plotted Result Graphs directly inline!\");\n",
      "rows": 47,
