{\"x\":90,\"y\":27},{\"x\":92,\"y\":24},{\"x\":74,\"y\":36},{\"x\":68,\"y\":37},{\"x\":68,\"y\":31},{\"x\":63,\"y\":38},{\"x\":70,\"y\":36},{\"x\":88,\"y\":36},{\"x\":75,\"y\":36},{\"x\":70,\"y\":34},{\"x\":67,\"y\":38},{\"x\":67,\"y\":32},{\"x\":67,\"y\":38},{\"x\":110,\"y\":25},{\"x\":85,\"y\":38},{\"x\":92,\"y\":26},{\"x\":112,\"y\":22},{\"x\":96,\"y\":32},{\"x\":84,\"y\":36},{\"x\":90,\"y\":27},{\"x\":86,\"y\":27},{\"x\":52,\"y\":44},{\"x\":84,\"y\":32},{\"x\":79,\"y\":28},{\"x\":82,\"y\":31}];\n           const surface = document.getElementById('explore_plot_7124');\n           \n           // Tell tfvis to specifically inject natively straight into our Notebook Cell Area!\n           tfvis.render.scatterplot(\n              surface,\n              {values}, \n              { xLabel: 'Horsepower', yLabel: 'MPG', height: 300 }\n           );\n        };\n\n        // Lazy load the TensorFlow Vis Graphical UI Engine entirely on the Foreground Thread\n        if (!window.tfvis) {\n           let s = document.createElement('script');\n           s.src = \"https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-vis\";\n           s.onload = renderPlot;\n           document.head.appendChild(s);\n        } else {\n           renderPlot();\n        }\n      </script>\n    ",
