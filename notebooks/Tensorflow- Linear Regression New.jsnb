    {
      "id": "a0f9a343279848cfa8eaf8b7e8961eb4",
      "cell_type": "code",
      "execution_count": 2,
      "is_executing": false,
      "cellindex_value": 1,
      "output": [
        "Mathematically processed rows: 392"
      ],
      "editorsValue": "(async () => {\n    // 1. Mathematically Fetch & Prepare Data\n    const carsDataReq = await fetch('https://storage.googleapis.com/tfjs-tutorials/carsData.json');\n    const carsData = await carsDataReq.json();\n\n    global.cleaned = carsData.map(car => ({\n      mpg: car.Miles_per_Gallon,\n      horsepower: car.Horsepower,\n    })).filter(car => (car.mpg != null && car.horsepower != null));\n\n    console.log(\"Mathematically processed rows:\", global.cleaned.length);\n\n    // 2. Generate a Unique Div ID and Inject raw HTML visualization payload!\n    const plotId = \"explore_plot_\" + Math.floor(Math.random()*10000);\n\n    const htmlPayload = `\n      <div id=\"${plotId}\" style=\"min-height: 250px;min-width: 500px\"><b>Loading Visual Engine...</b></div>\n      <script>\n        const renderPlot = () => {\n           const values = ${JSON.stringify(global.cleaned.map(d => ({x: d.horsepower, y: d.mpg})))};\n           const surface = document.getElementById('${plotId}');\n           \n           // Tell tfvis to specifically inject natively straight into our Notebook Cell Area!\n           tfvis.render.scatterplot(\n              surface,\n              {values}, \n              { xLabel: 'Horsepower', yLabel: 'MPG', height: 300 }\n           );\n        };\n\n        // Lazy load the TensorFlow Vis Graphical UI Engine entirely on the Foreground Thread\n        if (!window.tfvis) {\n           let s = document.createElement('script');\n           s.src = \"https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-vis\";\n           s.onload = renderPlot;\n           document.head.appendChild(s);\n        } else {\n           renderPlot();\n        }\n      </script>\n    `;\n\n    insertHTML(htmlPayload);\n})();\n",
      "rows": 45,
      "plotly_input": {},
