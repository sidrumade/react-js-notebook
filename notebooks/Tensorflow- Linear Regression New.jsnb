      "editorsValue": "// Using markdown\n// Try changing this cell to markdown via Header Controls or keep it as Javascript\n// Load Mathematical Core in Background Kernel\nloadLibrary(\"https://cdn.jsdelivr.net/npm/@tensorflow/tfjs\");\nconsole.log(\"Background TF successfully ready!\");\n",
      "rows": 6,
